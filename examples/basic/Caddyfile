# Railway — Railpack serves the build with Caddy and uses this file in place
# of its single-page-app default, so unknown URLs get dist/404.html with a 404
# status instead of the home page.
# Set the service variable RAILPACK_SPA_OUTPUT_DIR=dist: sitelo isn't one of
# the frameworks Railpack detects, and the variable turns on static serving.
# Railpack builds in /app, so the output lands in /app/dist.

:{$PORT:80} {
	root * /app/dist
	encode zstd gzip
	try_files {path} {path}/index.html
	file_server
	handle_errors {
		rewrite * /{err.status_code}.html
		file_server
	}
}
